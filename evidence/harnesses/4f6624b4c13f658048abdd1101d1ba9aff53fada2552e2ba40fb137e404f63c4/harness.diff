+#!/usr/bin/env python3
+"""Normalize a delimited data file (CSV/TSV) whose cells may contain
+inner-delimited multi-value fields, and report the counts needed to
+reconcile a deliverable against its source.
+
+Usage:
+  python3 scripts/normalize_delimited.py <file.csv> [--delimiter ,] [--inner ;]
+      [--fields col1,col2] [--out out.json] [--markdown] [--max-col-width 40]
+
+Behavior:
+  * Parses with the csv module (quoted fields handled correctly).
+  * If --inner is given, every cell (or only --fields columns) that contains
+    the inner delimiter is split into a list; a cell without it stays as-is.
+  * Prints: row count, column list, per-column non-empty counts, per-column
+    count of cells containing the inner delimiter, and duplicate-key check on
+    the first column if --key is given.
+  * With --out, writes a JSON array of row objects (inner-split values as lists).
+  * With --markdown, prints a markdown table of the normalized rows.
+
+Exit code 0 on success; row/cell counts are printed on stdout for reuse.
+"""
+
+import argparse
+import csv
+import json
+import sys
+
+
+def main():
+    ap = argparse.ArgumentParser(description="Normalize delimited data with inner multi-value cells.")
+    ap.add_argument("path", nargs="?", default="-", help="input file, '-' for stdin")
+    ap.add_argument("--delimiter", default=",", help="field delimiter (default ',')")
+    ap.add_argument("--inner", default=None, help="inner delimiter for multi-value cells, e.g. ';'")
+    ap.add_argument("--fields", default=None, help="comma-separated column names to inner-split (default: any)")
+    ap.add_argument("--key", default=None, help="column to check for duplicate values")
+    ap.add_argument("--out", default=None, help="write normalized rows as JSON to this path")
+    ap.add_argument("--markdown", action="store_true", help="also print a markdown table")
+    ap.add_argument("--max-col-width", type=int, default=40, help="markdown cell truncation width")
+    args = ap.parse_args()
+
+    handle = sys.stdin if args.path == "-" else open(args.path, newline="", encoding="utf-8-sig")
+    try:
+        reader = csv.DictReader(handle, delimiter=args.delimiter)
+        rows = [dict(r) for r in reader]
+        columns = list(reader.fieldnames or [])
+    finally:
+        if handle is not sys.stdin:
+            handle.close()
+
+    if not rows:
+        print("ROW_COUNT 0")
+        print("WARNING: no data rows parsed - check the delimiter")
+        return 1
+
+    split_fields = set(args.fields.split(",")) if args.fields else None
+    inner_counts = {c: 0 for c in columns}
+    normalized = []
+    for row in rows:
+        out = {}
+        for col in columns:
+            val = (row.get(col) or "").strip()
+            if args.inner and val and args.inner in val and (split_fields is None or col in split_fields):
+                inner_counts[col] += 1
+                out[col] = [part.strip() for part in val.split(args.inner) if part.strip() != ""]
+            else:
+                out[col] = val
+        normalized.append(out)
+
+    print("ROW_COUNT", len(normalized))
+    print("COLUMNS", "|".join(columns))
+    for col in columns:
+        nonempty = sum(1 for r in normalized if r[col])
+        print("FILLED\t%s\t%d/%d" % (col, nonempty, len(normalized)))
+    if args.inner:
+        for col, n in inner_counts.items():
+            if n:
+                print("INNER_SPLIT\t%s\t%d" % (col, n))
+    if args.key:
+        if args.key not in columns:
+            print("WARNING: key column %r not found" % args.key)
+        else:
+            seen, dupes = set(), []
+            for r in normalized:
+                k = r[args.key]
+                ident = tuple(k) if isinstance(k, list) else (k,)
+                if ident in seen:
+                    dupes.append(str(ident))
+                seen.add(ident)
+            print("DUPLICATE_KEYS", len(dupes), "; ".join(dupes[:5]))
+
+    if args.out:
+        with open(args.out, "w", encoding="utf-8") as fh:
+            json.dump(normalized, fh, indent=2, ensure_ascii=False)
+        print("WROTE_JSON", args.out)
+
+    if args.markdown:
+        def cell(v):
+            text = "; ".join(v) if isinstance(v, list) else str(v)
+            text = text.replace("|", "\\|").replace("\n", " ")
+            if len(text) > args.max_col_width:
+                text = text[: args.max_col_width - 1] + "\u2026"
+            return text
+
+        print("| " + " | ".join(columns) + " |")
+        print("|" + "|".join(["---"] * len(columns)) + "|")
+        for r in normalized:
+            print("| " + " | ".join(cell(r[c]) for c in columns) + " |")
+    return 0
+
+
+if __name__ == "__main__":
+    sys.exit(main())
