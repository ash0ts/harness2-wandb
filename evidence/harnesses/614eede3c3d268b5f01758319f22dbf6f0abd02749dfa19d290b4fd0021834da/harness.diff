+"""Reopen produced deliverables with independent readers and flag problems.
+
+Usage: python3 scripts/verify_artifacts.py [file ...]
+With no arguments it scans ./output (then cwd) for xlsx/docx/csv files.
+Checks: files open, sheets/tabs are non-empty and carry headers, xlsx cells
+hold computed values rather than unevaluated formulas, documents have real
+content. Exit code 0 = all checks passed, 1 = at least one problem found.
+"""
+import glob
+import os
+import sys
+
+problems = []
+
+
+def flag(message):
+    problems.append(message)
+    print("  FAIL: %s" % message)
+
+
+def verify_xlsx(path):
+    import openpyxl
+
+    workbook = openpyxl.load_workbook(path)
+    values = openpyxl.load_workbook(path, data_only=True)
+    print("  sheets: %s" % workbook.sheetnames)
+    if not workbook.sheetnames:
+        flag("workbook has no sheets")
+        return
+    for name in workbook.sheetnames:
+        sheet = workbook[name]
+        filled = sum(
+            1 for row in sheet.iter_rows() for cell in row if cell.value not in (None, "")
+        )
+        if filled == 0:
+            flag("sheet %r is empty" % name)
+            continue
+        if filled <= 1:
+            flag("sheet %r has only %d non-empty cell(s)" % (name, filled))
+        header = [cell.value for cell in next(sheet.iter_rows(max_row=1))]
+        if all(v in (None, "") for v in header):
+            flag("sheet %r has no header row" % name)
+        unevaluated = sum(
+            1
+            for row_v, row_f in zip(values[name].iter_rows(), sheet.iter_rows())
+            for cell_v, cell_f in zip(row_v, row_f)
+            if isinstance(cell_f.value, str) and cell_f.value.startswith("=") and cell_v.value is None
+        )
+        if unevaluated:
+            flag(
+                "sheet %r has %d formula cell(s) with no computed value; write values instead"
+                % (name, unevaluated)
+            )
+    print("  OK xlsx opens: %s" % path)
+
+
+def verify_docx(path):
+    from docx import Document
+
+    document = Document(path)
+    paragraphs = [p for p in document.paragraphs if p.text.strip()]
+    words = sum(len(p.text.split()) for p in paragraphs)
+    print("  paragraphs=%d tables=%d words~=%d" % (len(paragraphs), len(document.tables), words))
+    if len(paragraphs) < 5:
+        flag("document has fewer than 5 non-empty paragraphs")
+    if words < 100:
+        flag("document has fewer than 100 words of body text")
+    print("  OK docx opens: %s" % path)
+
+
+def verify_csv(path):
+    import csv
+
+    with open(path, newline="", encoding="utf-8", errors="replace") as handle:
+        rows = list(csv.reader(handle))
+    if len(rows) < 2:
+        flag("csv has fewer than 2 rows")
+    print("  rows=%d cols=%d" % (max(len(rows) - 1, 0), len(rows[0]) if rows else 0))
+
+
+def find_default_files():
+    found = sorted(glob.glob(os.path.join("output", "**", "*.xls*"), recursive=True))
+    found += sorted(glob.glob(os.path.join("output", "**", "*.docx"), recursive=True))
+    if found:
+        return found
+    # fallback: top of cwd only (never recurse into input/reference folders)
+    found = sorted(glob.glob("*.xls*")) + sorted(glob.glob("*.docx"))
+    return found
+
+
+def main():
+    targets = sys.argv[1:] or find_default_files()
+    if not targets:
+        print("No deliverable files found to verify - nothing has been written yet.")
+        return 1
+    print("VERIFYING %d file(s)" % len(targets))
+    for target in targets:
+        print("- %s" % target)
+        if not os.path.exists(target):
+            flag("file does not exist")
+            continue
+        ext = os.path.splitext(target)[1].lower()
+        try:
+            if ext == ".xlsx":
+                verify_xlsx(target)
+            elif ext == ".docx":
+                verify_docx(target)
+            elif ext == ".csv":
+                verify_csv(target)
+            else:
+                print("  (skipped: unhandled extension)")
+        except Exception as error:
+            flag("could not open with independent reader: %s: %s" % (type(error).__name__, error))
+    if problems:
+        print("RESULT: %d problem(s) found" % len(problems))
+        return 1
+    print("RESULT: all checks passed")
+    return 0
+
+
+if __name__ == "__main__":
+    sys.exit(main())
