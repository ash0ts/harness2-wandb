+#!/usr/bin/env python3
+"""Coverage audit for cross-source reconciliation.
+
+Usage: python3 scripts/recon_audit.py FILE [FILE ...]
+
+For each CSV/XLSX file (one unit per sheet for workbooks) prints:
+  - shape, columns with dtypes, non-null counts and cardinalities,
+  - a sample of distinct values for low-cardinality columns,
+  - min/max for columns that parse as dates,
+then, across all units, for every pair of same-named columns (case/space
+insensitive match) reports the value-set overlap with samples of one-side-only
+values. Output is capped so it stays readable in a terminal.
+"""
+
+import sys
+import os
+import re
+
+import pandas as pd
+
+MAX_SAMPLE = 8
+MAX_CARDINALITY_SHOW = 30
+
+
+def load_units(paths):
+    units = []
+    for path in paths:
+        if not os.path.exists(path):
+            print(f"!! not found: {path}")
+            continue
+        base = os.path.basename(path)
+        ext = os.path.splitext(base)[1].lower()
+        try:
+            if ext == ".csv":
+                units.append((base, pd.read_csv(path, low_memory=False)))
+            elif ext in (".xlsx", ".xls"):
+                xl = pd.ExcelFile(path)
+                for sheet in xl.sheet_names:
+                    units.append((f"{base}::{sheet}", xl.parse(sheet)))
+            else:
+                print(f"!! unsupported type skipped: {path}")
+        except Exception as exc:  # noqa: BLE001 - report and continue
+            print(f"!! failed to read {path}: {exc}")
+    return units
+
+
+def norm_col(name):
+    return re.sub(r"[^a-z0-9]+", "", str(name).lower())
+
+
+def profile_unit(label, df):
+    print(f"\n=== {label}  shape={df.shape[0]}x{df.shape[1]} ===")
+    for col in df.columns:
+        s = df[col]
+        card = s.nunique(dropna=True)
+        line = f"  {col} [{s.dtype}] nonnull={s.notna().sum()} unique={card}"
+        if 0 < card <= MAX_CARDINALITY_SHOW:
+            vals = [str(v) for v in s.dropna().unique()[:MAX_CARDINALITY_SHOW]]
+            line += " values: " + ", ".join(vals)
+        print(line)
+        if s.dtype == object and card > MAX_CARDINALITY_SHOW:
+            parsed = pd.to_datetime(s, errors="coerce", format="mixed")
+            ok = parsed.notna().mean()
+            if ok > 0.8:
+                print(f"    date-like ({ok:.0%} parse): min={parsed.min()} max={parsed.max()}")
+
+
+def key_sets(units):
+    by_col = {}
+    for label, df in units:
+        for col in df.columns:
+            vals = set(df[col].dropna().astype(str).str.strip())
+            if vals:
+                by_col.setdefault(norm_col(col), []).append((label, str(col), vals))
+    return by_col
+
+
+def cross_overlap(by_col):
+    print("\n=== cross-file overlap for same-named columns ===")
+    seen = set()
+    for key, entries in sorted(by_col.items()):
+        if len(entries) < 2:
+            continue
+        for i in range(len(entries)):
+            for j in range(i + 1, len(entries)):
+                la, ca, va = entries[i]
+                lb, cb, vb = entries[j]
+                pair = (la, ca, lb, cb)
+                rpair = (lb, cb, la, ca)
+                if pair in seen or rpair in seen:
+                    continue
+                seen.add(pair)
+                inter = va & vb
+                pct_a = (len(inter) / len(va) * 100) if va else 0.0
+                pct_b = (len(inter) / len(vb) * 100) if vb else 0.0
+                print(f"\n  {la}.{ca} x {lb}.{cb}: "
+                      f"|A|={len(va)} |B|={len(vb)} |A&B|={len(inter)} "
+                      f"(A cover {pct_a:.0f}%, B cover {pct_b:.0f}%)")
+                only_a = sorted(va - vb)[:MAX_SAMPLE]
+                only_b = sorted(vb - va)[:MAX_SAMPLE]
+                if only_a:
+                    print(f"    only in A: {', '.join(only_a)}")
+                if only_b:
+                    print(f"    only in B: {', '.join(only_b)}")
+                if not inter:
+                    print("    ZERO overlap — check identifier format variants before treating as a true mismatch")
+
+
+def main(argv):
+    paths = [a for a in argv[1:] if not a.startswith("-")]
+    if not paths:
+        print(__doc__)
+        return 1
+    units = load_units(paths)
+    if not units:
+        return 1
+    for label, df in units:
+        profile_unit(label, df)
+    cross_overlap(key_sets(units))
+    return 0
+
+
+if __name__ == "__main__":
+    sys.exit(main(sys.argv))
