+"""Inventory a task workspace: structure of every data/document file, compactly.
+
+Usage: python3 scripts/inventory_workspace.py [root]
+Prints one bounded block per file (row/column counts, sheets, headers,
+sample rows, headings) so the whole input landscape is visible in a single
+tool call. Output is deliberately capped per file.
+"""
+import csv
+import os
+import sys
+
+SKIP_DIRS = {"output", ".git", ".opencode", "node_modules", "__pycache__"}
+
+
+def brief(value, limit=160):
+    text = str(value).replace("\n", " | ").replace("\r", " ")
+    if len(text) > limit:
+        text = text[:limit] + "..."
+    return text
+
+
+def inventory_csv(path):
+    with open(path, newline="", encoding="utf-8", errors="replace") as handle:
+        rows = list(csv.reader(handle))
+    if not rows:
+        return "csv, EMPTY FILE"
+    header, body = rows[0], rows[1:]
+    lines = [
+        "csv, %d data rows, %d cols: %s" % (len(body), len(header), brief(", ".join(header)))
+    ]
+    for row in body[:2]:
+        lines.append("  sample: " + brief(", ".join(row)))
+    return "\n".join(lines)
+
+
+def inventory_xlsx(path):
+    import openpyxl
+
+    workbook = openpyxl.load_workbook(path, read_only=True, data_only=True)
+    lines = ["xlsx, sheets: %s" % workbook.sheetnames]
+    for name in workbook.sheetnames:
+        sheet = workbook[name]
+        sample = []
+        for index, row in enumerate(sheet.iter_rows(values_only=True)):
+            if index > 1:
+                break
+            sample.append(row)
+        lines.append("  %s: dims=%dx%d" % (name, sheet.max_row, sheet.max_column))
+        for row in sample:
+            lines.append("    " + brief(row))
+    workbook.close()
+    return "\n".join(lines)
+
+
+def inventory_docx(path):
+    from docx import Document
+
+    document = Document(path)
+    headings = [p.text.strip() for p in document.paragraphs if p.text.strip()][:12]
+    return "docx, paragraphs=%d, tables=%d (rows each: %s)\n  first lines: %s" % (
+        len(document.paragraphs),
+        len(document.tables),
+        [len(t.rows) for t in document.tables],
+        brief(" || ".join(headings), 280),
+    )
+
+
+def inventory_text(path):
+    with open(path, encoding="utf-8", errors="replace") as handle:
+        lines = handle.readlines()
+    return "text, %d lines\n  first: %s" % (len(lines), brief("".join(lines[:2])))
+
+
+def inventory(root):
+    for dirpath, dirnames, filenames in os.walk(root):
+        dirnames[:] = [d for d in dirnames if d not in SKIP_DIRS and not d.startswith(".")]
+        for filename in sorted(filenames):
+            if filename.startswith("."):
+                continue
+            path = os.path.join(dirpath, filename)
+            rel = os.path.relpath(path, root)
+            print("== %s (%d bytes)" % (rel, os.path.getsize(path)))
+            ext = os.path.splitext(filename)[1].lower()
+            try:
+                if ext == ".csv":
+                    print(inventory_csv(path))
+                elif ext in (".xlsx", ".xlsm"):
+                    print(inventory_xlsx(path))
+                elif ext == ".docx":
+                    print(inventory_docx(path))
+                elif ext in (".txt", ".md"):
+                    print(inventory_text(path))
+                else:
+                    print("  (binary/unhandled format)")
+            except Exception as error:  # report, never crash the inventory
+                print("  ERROR reading: %s: %s" % (type(error).__name__, error))
+
+
+if __name__ == "__main__":
+    root = sys.argv[1] if len(sys.argv) > 1 else os.getcwd()
+    print("WORKSPACE INVENTORY: %s" % os.path.abspath(root))
+    inventory(root)
